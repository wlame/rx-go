{
  "ContextLine": {
    "additionalProperties": false,
    "properties": {
      "absolute_line_number": {
        "format": "int64",
        "type": "integer"
      },
      "absolute_offset": {
        "format": "int64",
        "type": "integer"
      },
      "line_text": {
        "type": "string"
      },
      "line_text_truncated": {
        "description": "True when line_text holds only the first RX_MAX_LINE_TEXT_BYTES bytes of a longer line.",
        "type": "boolean"
      },
      "relative_line_number": {
        "format": "int64",
        "type": "integer"
      }
    },
    "required": [
      "relative_line_number",
      "absolute_line_number",
      "line_text",
      "absolute_offset",
      "line_text_truncated"
    ],
    "type": "object"
  },
  "Match": {
    "additionalProperties": false,
    "properties": {
      "absolute_line_number": {
        "format": "int64",
        "type": "integer"
      },
      "file": {
        "type": "string"
      },
      "line_text": {
        "type": [
          "string",
          "null"
        ]
      },
      "line_text_truncated": {
        "description": "True when line_text holds only the first RX_MAX_LINE_TEXT_BYTES bytes of a longer line.",
        "type": "boolean"
      },
      "offset": {
        "format": "int64",
        "type": "integer"
      },
      "pattern": {
        "type": "string"
      },
      "relative_line_number": {
        "format": "int64",
        "type": [
          "integer",
          "null"
        ]
      },
      "submatches": {
        "items": {
          "$ref": "#/components/schemas/Submatch"
        },
        "type": [
          "array",
          "null"
        ]
      },
      "submatches_truncated": {
        "description": "True when submatches may leave some of the line's submatches out: the line had more than RX_MAX_SUBMATCHES_PER_LINE, or line_text is cut and the list covers only the text it holds.",
        "type": "boolean"
      }
    },
    "required": [
      "pattern",
      "file",
      "offset",
      "relative_line_number",
      "absolute_line_number",
      "line_text",
      "submatches",
      "line_text_truncated",
      "submatches_truncated"
    ],
    "type": "object"
  },
  "SkippedFile": {
    "additionalProperties": false,
    "properties": {
      "path": {
        "type": "string"
      },
      "reason": {
        "type": "string"
      }
    },
    "required": [
      "path",
      "reason"
    ],
    "type": "object"
  },
  "Submatch": {
    "additionalProperties": false,
    "properties": {
      "end": {
        "format": "int64",
        "type": "integer"
      },
      "start": {
        "format": "int64",
        "type": "integer"
      },
      "text": {
        "type": "string"
      }
    },
    "required": [
      "text",
      "start",
      "end"
    ],
    "type": "object"
  },
  "TraceResponse": {
    "additionalProperties": false,
    "properties": {
      "after_context": {
        "format": "int64",
        "type": [
          "integer",
          "null"
        ]
      },
      "before_context": {
        "format": "int64",
        "type": [
          "integer",
          "null"
        ]
      },
      "cli_command": {
        "type": [
          "string",
          "null"
        ]
      },
      "context_lines": {
        "additionalProperties": {
          "items": {
            "$ref": "#/components/schemas/ContextLine"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "type": "object"
      },
      "file_chunks": {
        "additionalProperties": {
          "format": "int64",
          "type": "integer"
        },
        "type": "object"
      },
      "files": {
        "additionalProperties": {
          "type": "string"
        },
        "type": "object"
      },
      "matches": {
        "items": {
          "$ref": "#/components/schemas/Match"
        },
        "type": "array"
      },
      "max_results": {
        "format": "int64",
        "type": [
          "integer",
          "null"
        ]
      },
      "path": {
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "patterns": {
        "additionalProperties": {
          "type": "string"
        },
        "type": "object"
      },
      "request_id": {
        "type": "string"
      },
      "scanned_files": {
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "skip_reasons": {
        "description": "Why each path of skipped_files was passed over or not searched in full, one entry per path in the same order.",
        "items": {
          "$ref": "#/components/schemas/SkippedFile"
        },
        "type": "array"
      },
      "skipped_files": {
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "time": {
        "format": "double",
        "type": "number"
      }
    },
    "required": [
      "request_id",
      "path",
      "time",
      "patterns",
      "files",
      "matches",
      "scanned_files",
      "skipped_files",
      "skip_reasons",
      "max_results",
      "file_chunks",
      "context_lines",
      "before_context",
      "after_context",
      "cli_command"
    ],
    "type": "object"
  }
}
